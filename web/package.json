{
  "name": "tape-web",
  "private": true,
  "version": "0.1.0",
  "description": "The public live viewer for the Kalshi tape: a WebGL2 order-book heatmap.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "mock": "node dev/mock-server.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "ws": "8.21.3"
  }
}
